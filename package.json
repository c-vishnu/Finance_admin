    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "6.4.2"
  }
}
