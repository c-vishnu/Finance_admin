{
  "name": "finance-erp-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4001 --strictPort",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --port 4001 --strictPort",
    "test:sites": "node --test tests/sites-worker.test.mjs",
